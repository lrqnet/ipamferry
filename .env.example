APP_NAME=IpamFerry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
IPAMFERRY_ALLOW_INSECURE_HTTP=false
IPAMFERRY_NETBOX_PAGE_SIZE=200
IPAMFERRY_NETBOX_MAX_OBJECTS_PER_TYPE=1000000
IPAMFERRY_PHPIPAM_MAX_OBJECTS_PER_TYPE=1000000
IPAMFERRY_API_MAX_RESPONSE_BYTES=268435456
IPAMFERRY_APPLY_BATCH_SIZE=25
IPAMFERRY_DUMP_MAX_ROWS=5000000
IPAMFERRY_DUMP_MAX_BYTES=1073741824
IPAMFERRY_DUMP_RETENTION_HOURS=24
IPAMFERRY_OPERATION_LOCK_SECONDS=14400
IPAMFERRY_SANDBOX_URL=http://sandbox-netbox:8080
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ipamferry
DB_USERNAME=ipamferry
DB_PASSWORD=secret
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
