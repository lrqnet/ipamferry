{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "lrqnet/ipamferry",
  "description": "A self-hosted migration workbench for phpIPAM to NetBox.",
  "type": "project",
  "license": "AGPL-3.0-only",
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/fortify": "^1.37",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "laravel/sail": "^1.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --force", "npm ci", "npm run build"],
    "lint": "pint --parallel",
    "lint:check": "pint --parallel --test",
    "types:check": "phpstan analyse --memory-limit=1G",
    "test": ["@lint:check", "@types:check", "@php artisan test"]
  },
  "config": {"optimize-autoloader": true, "sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
